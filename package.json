{
  "name": "vibeai-tenant-admin",
  "version": "0.1.0",
  "private": true,
  "description": "VibeAI 店家後台 — 設計系統 + 頁面骨架（Next.js App Router）",
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration --config vitest.integration.config.mts --no-file-parallelism",
    "test:e2e": "playwright test",
    "test:all": "npm run typecheck && npm test && npm run test:integration && npm run test:e2e",
    "agent:pr-janitor": "node scripts/agents/pr-janitor.mjs",
    "agent:run:init": "node scripts/agents/run-ledger.mjs init",
    "agent:run:validate": "node scripts/agents/run-ledger.mjs validate",
    "agent:run:score": "node scripts/agents/score-run.mjs",
    "agent:run:review": "node scripts/agents/review-runs.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.120.0",
    "@supabase/ssr": "^0.6.1",
    "@supabase/supabase-js": "^2.112.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "0.469.0",
    "next": "15.5.23",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "resend": "^4.8.0",
    "tailwind-merge": "2.6.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "22.10.5",
    "@types/react": "19.0.7",
    "@types/react-dom": "19.0.7",
    "@vitest/coverage-v8": "^4.1.11",
    "autoprefixer": "10.4.20",
    "postcss": "8.4.49",
    "tailwindcss": "3.4.17",
    "typescript": "5.7.3",
    "vitest": "^4.1.11"
  }
}
