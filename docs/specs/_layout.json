 "topbarHTML": "<header class=\"topbar\">\n<div class=\"topbar-left\">\n<!-- 手機版選單切換（待處理數顯示在此，手機側欄收合時才看得到）-->\n<button class=\"btn-sidebar-toggle d-md-none position-relative\" id=\"sidebarToggleMobile\">\n<i class=\"bi bi-list\"></i>\n<span class=\"badge badge-count bg-danger rounded-pill\" id=\"hamburgerPendingBadge\" style=\"display:none;position:absolute;top:2px;right:2px;font-size:11px;min-width:18px;padding:2px 5px;\">\n</span>\n</button>\n<!-- 當前店家指示 chip（最顯眼處，多店家時可點開切換） -->\n<button id=\"currentTenantChip\" onclick=\"openTenantPickerModal()\" onmouseout=\"this.style.background='#f5f5f7'\" onmouseover=\"this.style.background='#ececf0'\" style=\"display:none;align-items:center;gap:6px;\n                                   background:#f5f5f7;color:#1d1d1f;\n                                   border:1px solid rgba(0,0,0,.08);padding:6px 14px;border-radius:20px;font-weight:600;font-size:13px;\n                                   cursor:pointer;box-shadow:none;transition:all .15s;\" type=\"button\">\n<i class=\"bi bi-shop\" style=\"font-size:14px;\"></i>\n<span id=\"currentTenantChipName\">店家</span>\n<i class=\"bi bi-chevron-expand\" id=\"currentTenantChipArrow\" style=\"font-size:11px;opacity:.85;display:none;\"></i>\n</button>\n</div>\n<div class=\"topbar-right\">\n<!-- 點數餘額 -->\n<div class=\"points-badge\">\n<i class=\"bi bi-coin\"></i>\n<span id=\"pointsBalance\">-</span>\n</div>\n<!-- 用戶下拉選單 -->\n<div class=\"dropdown\">\n<div aria-expanded=\"false\" class=\"user-dropdown\" data-bs-toggle=\"dropdown\" id=\"userDropdown\">\n<span class=\"user-avatar\">U</span>\n<span class=\"user-name d-none d-md-inline\">使用者</span>\n<span class=\"tenant-name d-none d-lg-inline\"></span>\n<i class=\"bi bi-chevron-down ms-1\"></i>\n</div>\n<ul class=\"dropdown-menu dropdown-menu-end\" id=\"userDropdownMenu\">\n<!-- 多店家切換區（單店家用戶不顯示） -->\n<li class=\"tenant-switcher-section\" id=\"tenantSwitcherTopbarSection\" style=\"display:none;\">\n<h6 class=\"dropdown-header\"><i class=\"bi bi-shop me-1\"></i>切換店家</h6>\n<div id=\"tenantSwitcherTopbarList\"></div>\n<hr class=\"dropdown-divider\"/>\n</li>\n<li>\n<a class=\"dropdown-item\" href=\"/tenant/settings\">\n<i class=\"bi bi-gear me-2\"></i>店家設定\n                                </a>\n</li>\n<!-- 安裝手機 App（PWA）：已安裝時由 tenant.js 隱藏 -->\n<li id=\"installAppMenuItem\" style=\"display:none;\">\n<a class=\"dropdown-item\" href=\"#\" onclick=\"openInstallApp(); return false;\">\n<i class=\"bi bi-phone me-2\"></i>安裝手機 App\n                                </a>\n</li>\n<!-- 開啟推播通知：未授權且伺服器已啟用推播時由 tenant.js 顯示 -->\n<li id=\"enablePushMenuItem\" style=\"display:none;\">\n<a class=\"dropdown-item\" href=\"#\" onclick=\"enablePushNotification(); return false;\">\n<i class=\"bi bi-bell me-2\"></i>開啟新預約推播\n                                </a>\n</li>\n<li><hr class=\"dropdown-divider\"/></li>\n<li>\n<a class=\"dropdown-item\" href=\"#\" onclick=\"tenantLogout()\">\n<i class=\"bi bi-box-arrow-right me-2\"></i>登出\n                                </a>\n</li>\n</ul>\n</div>\n</div>\n</header>",
 "topbarText": "店家 - U 使用者 切換店家 店家設定 安裝手機 App 開啟新預約推播 登出",
 "footerText": "Copyright © 瓦比艾有限公司 VibeAI Co., Ltd. 2026"
}