# =============================================================================
# VibeAI 店家後台 — 平台層環境變數
# 複製成 .env.local 後修改。骨架模式（NEXT_PUBLIC_USE_MOCK=true）下全部可留空。
#
# ⚠️ 請注意：LINE Channel ID / Secret / Access Token 不在這裡。
#    那是「每家店自己的」設定，由店家在後台 /tenant/line-settings 頁面輸入，
#    存進資料庫的 tenant_settings 表（加密欄位）。這樣同一份部署才能服務多家店。
# =============================================================================

NODE_ENV=development

# ---- 骨架 / Mock ----
# true  = 不需任何後端，所有資料走 src/mock（本地開發預設）
# false = 走真實 API，需設定 DATABASE_URL 與後端服務
NEXT_PUBLIC_USE_MOCK=true
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---- 資料庫 ----
DATABASE_URL=postgresql://user:password@localhost:5432/vibeai

# ---- 驗證與加密 ----
# openssl rand -hex 32
AUTH_SECRET=
# openssl rand -hex 32  ← 用來加密租戶的 LINE Secret / Access Token
SETTINGS_ENCRYPTION_KEY=

# ---- 平台 OAuth（店家用 LINE / Google 登入「後台帳號」）----
# 這與店家自己的 LINE 官方帳號是兩套不同的 channel，不要混用
LINE_LOGIN_CHANNEL_ID=
LINE_LOGIN_CHANNEL_SECRET=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# ---- 寄信（Email 驗證碼、密碼重設、預約通知）----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="VibeAI <noreply@example.com>"

# ---- 檔案儲存 ----
STORAGE_DRIVER=local
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ---- Web Push（後台「開啟新預約推播」）----
# npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# ---- 分析 ----
NEXT_PUBLIC_GA_MEASUREMENT_ID=
