# =============================================================================
# VibeAI 店家後台 — 平台層環境變數
# 複製成 .env.local 後修改。骨架模式（NEXT_PUBLIC_USE_MOCK=true）下全部可留空。
#
# ⚠️ 請注意：LINE Channel ID / Secret / Access Token 不在這裡。
#    那是「每家店自己的」設定，由店家在後台 /tenant/line-settings 頁面輸入，
#    存進資料庫的 tenant_settings 表（加密欄位）。這樣同一份部署才能服務多家店。
# =============================================================================

NODE_ENV=development

# ---- 骨架 / Mock ----
# true  = 不需任何後端，所有資料走 src/mock（本地開發預設）
# false = 走真實 API，需設定 DATABASE_URL 與後端服務
NEXT_PUBLIC_USE_MOCK=true
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---- Supabase（真實後端，見 docs/integration/01-ARCHITECTURE.md §3）----
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# ⚠️ 最高權限金鑰：僅供 LINE webhook / Vercel Cron / 註冊流程使用，絕不進前端
SUPABASE_SERVICE_ROLE_KEY=

# ---- Resend 寄信（見 docs/integration/05-EMAIL-RESEND.md）----
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
MAIL_FROM="VibeAI <noreply@yourdomain.com>"

# ---- Telegram 通知與 Bot 綁定（#40；全為 server-only）----
# 平台共用的一個 Bot。Username 是 https://t.me/<username> 連結，不要填 @。
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_ID=
TELEGRAM_BOT_USERNAME=
# 任意高熵字串；與 Telegram 設定 webhook 時使用的 secret_token 完全相同。
# openssl rand -hex 32
TELEGRAM_WEBHOOK_SECRET=
# 每日通知健康報告的收件端（非租戶設定、不可暴露到前端）。
PLATFORM_OWNER_EMAIL=
PLATFORM_TELEGRAM_CHAT_ID=

# ---- Vercel Cron 保護（見 docs/integration/07-DEPLOYMENT-CRON.md）----
# openssl rand -hex 32
CRON_SECRET=

# ---- AI 客服（選配，AI_ASSISTANT 功能，見 docs/integration/09-FEATURE-STORE.md §7）----
ANTHROPIC_API_KEY=

# ---- 公開 API（見 docs/integration/11-PARTNER-API.md §4.1）----
# 允許呼叫 /api/public/** 的外部網域（Midao），逗號分隔
PUBLIC_CORS_ORIGINS=

# ---- 資料庫 ----
DATABASE_URL=postgresql://user:password@localhost:5432/vibeai

# ---- 驗證與加密 ----
# openssl rand -hex 32
AUTH_SECRET=
# openssl rand -hex 32  ← 用來加密租戶的 LINE Secret / Access Token
SETTINGS_ENCRYPTION_KEY=

# ---- 平台 OAuth（店家用 LINE / Google 登入「後台帳號」）----
# 這與店家自己的 LINE 官方帳號是兩套不同的 channel，不要混用
LINE_LOGIN_CHANNEL_ID=
LINE_LOGIN_CHANNEL_SECRET=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# ---- 寄信：SMTP（遺留設定；本專案實際走 Resend，見上方 RESEND_API_KEY / MAIL_FROM）----
# MAIL_FROM 只在上面的 Resend 區塊定義一次，不要在這裡重複（重複的鍵後者會覆蓋前者）
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# ---- 檔案儲存 ----
STORAGE_DRIVER=local
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ---- Web Push（後台「開啟新預約推播」）----
# npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# ---- 分析 ----
NEXT_PUBLIC_GA_MEASUREMENT_ID=
